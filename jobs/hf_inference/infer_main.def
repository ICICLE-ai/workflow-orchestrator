Bootstrap: docker
From: pytorch/pytorch:2.4.1-cuda12.1-cudnn9-runtime

%files
    infer_main.py /app/infer_main.py
    requirements.txt /app/requirements.txt

%environment
    export PATH="/usr/local/bin:/app:$PATH"
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    # Ultralytics and HuggingFace write config/cache to $HOME, which may be
    # read-only or shared in a job; keep them in-job instead.
    export YOLO_CONFIG_DIR=/tmp/ultralytics
    export MPLCONFIGDIR=/tmp/mpl
    export HF_HOME=/tmp/hf_home

%post
    echo "Setting up environment for infer_main.py"
    apt-get update
    # libGL / X11 libraries: ultralytics pulls in opencv-python, which needs them.
    apt-get install -y --no-install-recommends \
        ca-certificates \
        libgl1-mesa-glx \
        libglib2.0-0 \
        libxext6 \
        libxrender1 \
        libsm6
    rm -rf /var/lib/apt/lists/*
    echo "Installing required Python packages"
    cd /app
    python3 -m pip install --upgrade pip
    pip install --no-cache-dir -r requirements.txt
    echo "Python dependencies installed."
    chmod 755 /app/infer_main.py
    echo "Setup complete."

%runscript
    echo "infer_main.py"
    cd /app
    python3 infer_main.py "$@"

%labels
    Maintainer "Brijesh Nanda <brundayogananda.1@osu.edu>"
    Version "1.0.0"
    Appname "Model Inference"
    Description "Run a trained YOLO or HuggingFace model over an image directory; writes predictions.json and summary.json"
