Bootstrap: docker
From: python:3.12-bookworm

%files
    zero_shot_annotation.py /app/zero_shot_annotation.py
    requirements.txt /app/requirements.txt

%environment
    export PATH="/usr/local/bin:/app:$PATH"
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    # Source checkouts the insid3 backend imports from (neither is on PyPI).
    export INSID3_HOME=/opt/insid3
    export DINOV3_HOME=/opt/dinov3

%post
    echo "Setting up environment for zero_shot_annotation.py"
    apt-get update

    # libGL and X11 libraries required by opencv-python (mask -> polygon extraction).
    # Bookworm: libgl1 replaces bullseye's libgl1-mesa-glx. Bullseye itself is
    # past end of life, and its security mirror now 404s on package downloads.
    apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        libgl1 \
        libglib2.0-0 \
        libxext6 \
        libxrender1 \
        libfontconfig1 \
        libsm6 \
        libice6

    rm -rf /var/lib/apt/lists/*

    echo "Installing required packages"
    cd /app
    python3 -m pip install --upgrade pip
    pip install --no-cache-dir -r requirements.txt
    echo "Python dependencies installed."

    # INSID3 backend: the model code and the DINOv3 backbone definition.
    # Pinned because the backend calls INSID3's private pipeline steps
    # (see Insid3Backend). The DINOv3 WEIGHTS are not baked in — they sit
    # behind Meta's license form, so each job is handed a checkpoint path.
    # INSID3's optional CRF refiner is left out: it needs nvcc to build.
    git clone https://github.com/visinf/INSID3 /opt/insid3
    git -C /opt/insid3 checkout 0c165a10cf52ab91f335883d06260de86854adbe
    git clone https://github.com/facebookresearch/dinov3 /opt/dinov3
    git -C /opt/dinov3 checkout 6876159a11b4df116f30f667f8c9888617df0751
    rm -rf /opt/insid3/.git /opt/dinov3/.git
    chmod -R a+rX /opt/insid3 /opt/dinov3

    chmod 755 /app/zero_shot_annotation.py
    chmod 644 /app/requirements.txt
    echo "Setup complete."

%runscript
    cd /app
    python3 zero_shot_annotation.py "$@"

%labels
    Maintainer "Brijesh Nanda <brundayogananda.1@osu.edu>"
    Version "1.0"
    Appname "Zero-Shot Annotator"
    Description "Batch zero-shot annotation with SAM3 (pluggable backend), text and exemplar prompts, INSID3 in-context segmentation from reference exemplars, optional SAHI tiling"
