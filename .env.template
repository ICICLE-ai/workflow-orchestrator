DB_HOST=localhost
DB_PORT=5433
DB_USER=your_db_user
DB_PWD=your_db_password
DB_NAME=your_db_name

# DBOS Database Connection
DBOS_DATABASE_URL=postgresql://${DB_USER}:${DB_PWD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
DBOS_SYSTEM_DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PWD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
