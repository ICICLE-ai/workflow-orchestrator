# @icicle-ai/tapis-file-explorer, annotation-details and image-annotation-canvas
# (smart_labeler UI kit) declare peer ranges (react ^18, @mantine/core ^7) from
# their own monorepo, older than what this app runs (react 19, mantine 9). The
# packages work fine against the newer majors in practice; without this, both
# `npm install` and CI's `npm ci` fail on ERESOLVE.
legacy-peer-deps=true
