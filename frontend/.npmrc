# @icicle-ai/tapis-file-explorer, annotation-details and image-annotation-canvas
# (smart_labeler UI kit) declare peer ranges (react ^18, @mantine/core ^7) from
# their own monorepo, older than what this app runs (react 19, mantine 9). The
# packages work fine against the newer majors in practice; without this, both
# `npm install` and CI's `npm ci` fail on ERESOLVE.
legacy-peer-deps=true

# The @icicle-ai/* packages are published to GitHub Packages, not npmjs.org.
# Declared here rather than left to each developer's ~/.npmrc so a fresh clone
# resolves them the same way CI does — package-lock.json already pins
# npm.pkg.github.com download URLs, so this only makes the existing behaviour
# explicit.
#
# AUTHENTICATION IS STILL REQUIRED, and is deliberately not in this file.
# GitHub Packages returns 401 for the npm registry even on public packages, so
# every install needs a token:
#
#   local  ~/.npmrc:  //npm.pkg.github.com/:_authToken=<GitHub PAT, read:packages>
#   CI     see the frontend job in .github/workflows/build.yml
#
# Never commit a token here — this file is tracked.
@icicle-ai:registry=https://npm.pkg.github.com/
