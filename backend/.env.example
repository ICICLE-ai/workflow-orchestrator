# Copy this file to .env and fill in real values. .env is gitignored.
#
# Tapis connection. The backend resolves a JWT in this order:
#   1. TAPIS_TOKEN if set (used directly as the X-Tapis-Token header).
#   2. Otherwise, mint a token from TAPIS_USERNAME + TAPIS_PASSWORD via the
#      Tapis tokens API.
#   3. If neither is available, the engine falls back to the mock Tapis client,
#      so the system still runs and is testable without live credentials.

TAPIS_BASE_URL=https://icicleai.tapis.io
TAPIS_TENANT=icicleai

# --- Option A: paste an existing JWT (short-lived access token) ---
# TAPIS_TOKEN=

# --- Option B: username/password to mint a JWT at runtime ---
# TAPIS_USERNAME=
# TAPIS_PASSWORD=

# Optional: force the mock even if creds are present (true/false)
TAPIS_USE_MOCK=false
