# Copy this file to .env and fill in real values. .env is gitignored.
#
# Authentication is Tapis OAuth2 (authorization-code flow, per-user tokens):
#   - Users log in via /login, which redirects to Tapis. After consent, Tapis
#     redirects to {APP_BASE_URL}/oauth2/callback with a code that the backend
#     exchanges (using the confidential client below) for a per-user access +
#     refresh token. Those tokens are stored on the user and used by the engine
#     to submit jobs AS that user.
#   - For local development without a registered client, set TAPIS_USE_MOCK=true;
#     /login then signs in a mock user and the engine uses the mock Tapis client.

TAPIS_BASE_URL=https://icicleai.tapis.io
TAPIS_TENANT=icicleai

# --- Confidential OAuth2 client (register with Tapis: POST /v3/oauth2/clients) ---
# The client's callback_url MUST equal {APP_BASE_URL}/oauth2/callback.
TAPIS_CLIENT_ID=workflow-orchestrator
TAPIS_CLIENT_KEY=workflow-orchestrator-key

# Public base URL of THIS backend (used to build the OAuth callback URL).
APP_BASE_URL=https://citations-hay-images-housewives.trycloudflare.com
# Frontend URL to return the user to after login/logout.
FRONTEND_URL=http://localhost:5173

# Secret used to sign the session cookie. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Session cookie SameSite / Secure. Defaults (lax / false) suit an all-localhost
# setup. If the frontend and backend are on different hosts (e.g. backend behind
# a cloudflared tunnel, frontend on localhost), set these so the browser sends
# the cookie on cross-site API calls. SameSite=None REQUIRES Secure=true.
# SESSION_COOKIE_SAMESITE=none
# SESSION_COOKIE_SECURE=truehM3p5pFfX8Lb0lyoh_DjJ4P73E5mKnnhoDJNxe5ezuI

# Force the mock Tapis client + mock login even if a client is configured (true/false).
TAPIS_USE_MOCK=false
