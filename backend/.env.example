# Copy this file to .env and fill in real values. .env is gitignored.
#
# --- Embedded in TapisUI (host-supplied Tapis token) ---
# When this app is iframed inside TapisUI, the host has already authenticated the
# user and leaves the Tapis token in a cookie. The backend verifies that token
# (RS256, against the tenant's public key) and treats the request as
# authenticated — no OAuth redirect, no login button, nothing to configure below
# except the tenant.
#
# Two cookie shapes are accepted, no configuration needed:
#   tapis-token     TapisUI's own — a percent-encoded JSON envelope, not a bare
#                   token: {%22access_token%22:%22eyJ...%22%2C%22expires_in%22:14400}
#   X-Tapis-Token   a bare JWT, also accepted as a request header (which is how
#                   the frontend forwards it when the API is on another site)
#
# THE DEPLOYMENT IS THE INTEGRATION. Cookies are partitioned by registrable
# domain, so the only thing that makes this work is serving this app under the
# same parent domain the host's cookie is scoped to:
#
#     Cookie: X-Tapis-Token=...; Domain=.example.org
#       tapisui.example.org   the host
#       harvest.example.org   this frontend   <- cookie sent
#       api.example.org       this backend    <- cookie sent, request authenticates
#
# Run the frontend and backend on unrelated domains (a tunnel, localhost, a
# different registrable domain) and NOTHING can carry the token: the browser
# won't attach the cookie to the API call, and the frontend's document.cookie
# can't read another domain's cookie to forward it as the X-Tapis-Token header
# either. That is the single most likely cause of a 401 in embedded mode — hit
# GET /auth-debug from inside the iframe to see what actually arrived.
#
# BEFORE PLANNING THE DEPLOYMENT, check what the host's cookie is actually
# scoped to (devtools → Application → Cookies, on the TapisUI origin):
#   - `Domain=.example.org` (leading dot / parent domain) — any subdomain of it
#     works, per the layout above.
#   - No Domain attribute at all (host-only) — the cookie goes ONLY to the exact
#     host that set it, so a sibling subdomain will NOT receive it and this app
#     must be served from that same host under a path (e.g. a reverse proxy
#     mapping tapisui.example.org/harvest → this app).
# HttpOnly on the host's cookie is fine here: the backend reads it directly.
#
# SameSite: a same-registrable-domain iframe is a SAME-site context, so the
# default Lax settings below are correct for that layout. SameSite=None; Secure
# is only needed while frontend and backend are genuinely cross-site.
#
# Add TapisUI's origin to CORS_ALLOWED_ORIGINS only if the iframe loads THIS
# app's frontend from a different origin than FRONTEND_URL.
#
# Standalone (not embedded), authentication is Tapis OAuth2 (authorization-code
# flow, per-user tokens):
#   - Users log in via /login, which redirects to Tapis. After consent, Tapis
#     redirects to {APP_BASE_URL}/oauth2/callback with a code that the backend
#     exchanges (using the confidential client below) for a per-user access +
#     refresh token. Those tokens are stored on the user and used by the engine
#     to submit jobs AS that user.
#   - For local development without a registered client, set TAPIS_USE_MOCK=true;
#     /login then signs in a mock user and the engine uses the mock Tapis client.

TAPIS_BASE_URL=https://icicleai.tapis.io
TAPIS_TENANT=icicleai

# --- Direct-token mode (bypass OAuth) ---
# Set TAPIS_ACCESS_TOKEN to use a token directly for ALL Tapis calls (job submit +
# file browse), skipping the per-user OAuth login. Leave BLANK to use OAuth.
# Optionally add TAPIS_REFRESH_TOKEN; if a confidential client (below) is also set,
# the token auto-refreshes in-memory near expiry — otherwise it's used until it lapses.
TAPIS_ACCESS_TOKEN=
TAPIS_REFRESH_TOKEN=

# --- Confidential OAuth2 client (register with Tapis: POST /v3/oauth2/clients) ---
# The client's callback_url MUST equal {APP_BASE_URL}/oauth2/callback.
# Used for the per-user OAuth login, and to refresh the direct token above.
TAPIS_CLIENT_ID=workflow-orchestrator
TAPIS_CLIENT_KEY=workflow-orchestrator-key

# Public base URL of THIS backend (used to build the OAuth callback URL).
APP_BASE_URL=https://touch-among-extends-vocabulary.trycloudflare.com
# Frontend URL to return the user to after login/logout. Also added to the
# CORS allow-list automatically (see CORS_ALLOWED_ORIGINS below).
FRONTEND_URL=http://localhost:5173

# Extra origins allowed to call this API, beyond localhost:5173/127.0.0.1:5173
# and FRONTEND_URL (comma-separated). Needed if the frontend itself is also
# served remotely (e.g. a tunnel URL for testing on another device) rather
# than just the backend. A mismatch here is a genuine browser CORS error on
# every cross-origin call, not just one endpoint.
# CORS_ALLOWED_ORIGINS=https://your-frontend-tunnel.trycloudflare.com

# Secret used to sign the session cookie. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Session cookie SameSite / Secure. Defaults (lax / false) suit an all-localhost
# setup. If the frontend and backend are on different hosts (e.g. backend behind
# a cloudflared tunnel, frontend on localhost), set these so the browser sends
# the cookie on cross-site API calls. SameSite=None REQUIRES Secure=true.
# SESSION_COOKIE_SAMESITE=none
# SESSION_COOKIE_SECURE=truehM3p5pFfX8Lb0lyoh_DjJ4P73E5mKnnhoDJNxe5ezuI

# Force the mock Tapis client + mock login even if a client is configured (true/false).
TAPIS_USE_MOCK=false
