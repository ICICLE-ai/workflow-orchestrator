# Keep the build context small and, more importantly, keep secrets and host-only
# artifacts out of the image.

# Real credentials — Tapis client key, session secret, access tokens. .env is
# gitignored but NOT automatically excluded from a Docker build context, and a
# COPY . would bake it into a layer. Supply these with --env-file at run time.
.env
.env.*
!.env.example

# Host virtualenv: wrong platform (macOS wheels), hundreds of MB, and it would
# shadow the venv the builder stage installs.
.venv/
__pycache__/
*.py[cod]

# Not needed to run the service.
docker-compose.yml
*.md
.git/
.gitignore
.idea/
.vscode/
.DS_Store
