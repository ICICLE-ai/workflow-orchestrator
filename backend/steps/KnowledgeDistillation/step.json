{
  "step_type_key": "knowledge_dist",
  "display_name": "Knowledge Distillation",
  "description": "Distills a large teacher model into a smaller student model.",
  "category": "Training",
  "inputs": [
    { "name": "teacher_model", "type": "pytorch_model" },
    { "name": "dataset", "type": "image_dir" }
  ],
  "outputs": [
    { "name": "student_model", "type": "pytorch_model" },
    { "name": "metrics", "type": "json_results" }
  ],
  "config_schema": {
    "confidence_threshold": {
      "type": "float",
      "description": "Minimum confidence score to retain a prediction.",
      "default": 0.5
    },
    "device": {
      "type": "string",
      "description": "Compute device to use (cpu or cuda).",
      "default": "cuda"
    }
  }
}
