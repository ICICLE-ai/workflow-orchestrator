{
  "step_type_key": "training",
  "display_name": "Model Training",
  "description": "Trains YOLO or HuggingFace models for classification, detection and segmentation.",
  "category": "Training",
  "tapis_app_id": "workflow-orchestrator-trainer-v2",
  "inputs": [
    { "name": "dataset", "type": "image_dir" }
  ],
  "outputs": [
    { "name": "model",   "type": "pytorch_model", "output_path": "model" },
    { "name": "metrics", "type": "json_results",  "output_path": "metrics.json" }
  ],
  "config_schema": {
    "framework": {
      "type": "str",
      "description": "Training framework: yolo or huggingface",
      "default": "huggingface"
    },
    "model": {
      "type": "str",
      "description": "Model name e.g. google/vit-base-patch16-224 or yolov8n.pt",
      "default": "google/vit-base-patch16-224"
    },
    "task": {
      "type": "str",
      "description": "Task type: classify, detect or segment",
      "default": "classify"
    },
    "epochs": {
      "type": "int",
      "description": "Number of full passes through the training dataset.",
      "default": 50
    },
    "batch_size": {
      "type": "int",
      "description": "Number of training examples utilized in one iteration.",
      "default": 16
    },
    "learning_rate": {
      "type": "float",
      "description": "Step size at each iteration while moving toward a minimum of a loss function.",
      "default": 0.001
    },
    "warmup_steps": {
      "type": "int",
      "description": "Number of warmup steps",
      "default": 0
    },
    "seed": {
      "type": "int",
      "description": "Random seed for reproducibility",
      "default": 42
    },
    "patience": {
      "type": "int",
      "description": "Early stopping patience in epochs.",
      "default": 3
    },
    "device": {
      "type": "str",
      "description": "Device: cuda or cpu",
      "default": "cuda"
    },
    "wandb_key": {
      "type": "str",
      "description": "W&B API key for live experiment tracking (optional)",
      "default": ""
    },
    "wandb_project": {
      "type": "str",
      "description": "W&B project name",
      "default": "workflow-orchestrator"
    },
    "extra_args": {
      "type": "str",
      "description": "Extra CLI arguments passed to train_main.py e.g. --lr 0.001 --seed 42",
      "default": ""
    }
  },
  "tapis_job": {
    "name": "workflow-orchestrator-training",
    "appId": "workflow-orchestrator-trainer-v2",
    "appVersion": "1.0",
    "description": "Workflow Orchestrator model training",
    "execSystemId": "${exec_system}",
    "execSystemLogicalQueue": "${exec_queue}",
    "archiveSystemId": "${archive_system}",
    "archiveSystemDir": "${archive_dir}",
    "nodeCount": 1,
    "coresPerNode": 8,
    "memoryMB": 64000,
    "maxMinutes": 120,
    "fileInputs": [
      {
        "name": "container SIF",
        "envKey": "sifpath",
        "autoMountLocal": true,
        "sourceUrl": "https://icicleai.tapis.io/v3/files/postits/redeem/48caa51f-8cbb-49e7-a7c7-349d9ce6f4ab-010",
        "targetPath": "trainer.sif"
      }
    ],
    "parameterSet": {
      "appArgs": [
        { "name": "framework",      "arg": "--framework ${framework}"           },
        { "name": "model",          "arg": "--model ${model}"                   },
        { "name": "task",           "arg": "--task ${task}"                     },
        { "name": "data",           "arg": "--data ${dataset}"                  },
        { "name": "output_path",    "arg": "--output_path ${archive_dir}"       },
        { "name": "epochs",         "arg": "--epochs ${epochs}"                 },
        { "name": "batch",          "arg": "--batch ${batch_size}"              },
        { "name": "device",         "arg": "--device ${device}"                 },
        { "name": "lr",             "arg": "--lr ${learning_rate}"              },
        { "name": "warmup_steps",   "arg": "--warmup_steps ${warmup_steps}"     },
        { "name": "seed",           "arg": "--seed ${seed}"                     },
        { "name": "patience",       "arg": "--patience ${patience}"             },
        { "name": "wandb_key",      "arg": "--wandb_key ${wandb_key}"           },
        { "name": "wandb_project",  "arg": "--wandb_project ${wandb_project}"   },
        { "name": "extra_args",     "arg": "${extra_args}"                      }
      ],
      "containerArgs": [
        { "name": "hf_cache", "arg": "--bind /fs/scratch/PAS2699/yolo_training/mod/hf_cache:/app/hf_cache" }
      ],
      "schedulerOptions": [
        { "name": "account",  "arg": "-A ${slurm_account}" },
        { "name": "job name", "arg": "--job-name=workflow-orchestrator-training" },
        { "name": "gpu",      "arg": "-G 1" }
      ],
      "archiveFilter": { "includeLaunchFiles": false }
    }
  }
}