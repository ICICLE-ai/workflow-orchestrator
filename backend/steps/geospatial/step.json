{
  "step_type_key": "geospatial",
  "display_name": "🌐 Geospatial (GeoPackage)",
  "description": "Builds a GeoPackage (.gpkg) of weed/residue heatmap and farm-boundary layers from Harvest-style JSON results + image EXIF GPS. Shapefile/GeoJSON/raw-GeoPackage exports are generated on demand via /api/pipeline-runs/{run_id}/geospatial/... (see backend/geospatial.py) — the GeoPackage itself is the only thing stored.",
  "category": "Post-processing",
  "icon": "map",
  "tapis_app_id": "PLACEHOLDER-harvest-Geospatial-app",
  "inputs": [
    { "name": "results", "type": "json_results" },
    { "name": "images", "type": "image_dir", "required": false }
  ],
  "outputs": [
    { "name": "gpkg_output", "type": "geopackage", "output_path": "output.gpkg" }
  ],
  "config_schema": {
    "generator_mode": {
      "type": "string",
      "description": "Heatmap source mode: 'detection' (use images) or 'results'.",
      "default": "detection"
    },
    "spray_mode": {
      "type": "string",
      "description": "'binary' or 'custom' spray-decision banding.",
      "default": "binary"
    },
    "spray_levels": {
      "type": "string",
      "description": "spray_mode=custom only: space-separated names for each spray band (e.g. 'low medium high').",
      "default": ""
    },
    "spray_thresholds": {
      "type": "string",
      "description": "spray_mode=custom only: space-separated integer count thresholds, one per spray_levels entry.",
      "default": ""
    },
    "grid_width": {
      "type": "int",
      "description": "Grid cell width in feet.",
      "default": 30
    },
    "grid_height": {
      "type": "int",
      "description": "Grid cell height in feet.",
      "default": 30
    },
    "fov_width_ft": {
      "type": "float",
      "description": "Camera ground footprint width at flight altitude, in feet.",
      "default": 29.0
    },
    "fov_height_ft": {
      "type": "float",
      "description": "Camera ground footprint height at flight altitude, in feet.",
      "default": 22.0
    },
    "gps_offset_x_ft": {
      "type": "float",
      "description": "East-west offset (feet) between an image's GPS tag and its optical center.",
      "default": 0.0
    },
    "gps_offset_y_ft": {
      "type": "float",
      "description": "North-south offset (feet) between an image's GPS tag and its optical center.",
      "default": 0.0
    },
    "image_width_px": {
      "type": "int",
      "description": "Source image width in pixels, used for bounding-box-to-ground projection.",
      "default": 4000
    },
    "image_height_px": {
      "type": "int",
      "description": "Source image height in pixels, used for bounding-box-to-ground projection.",
      "default": 3000
    }
  },
  "tapis_job": {
    "name": "geospatial-gpkg",
    "appId": "PLACEHOLDER-harvest-Geospatial-app",
    "appVersion": "1.0.0",
    "description": "PLACEHOLDER job template — swap appId/appVersion once a real GeoPackage-emitting Tapis app exists (that app is outside this repo and was not verified during this change).",
    "execSystemId": "expanse-tapis",
    "execSystemLogicalQueue": "tapisShared",
    "archiveSystemId": "${archive_system}",
    "archiveSystemDir": "${archive_dir}",
    "nodeCount": 1,
    "coresPerNode": 12,
    "memoryMB": 8192,
    "maxMinutes": 200,
    "fileInputs": [
      { "name": "results", "envKey": "results", "autoMountLocal": true, "sourceUrl": "${results}", "targetPath": "input/results.json" },
      { "name": "images", "envKey": "images", "autoMountLocal": true, "sourceUrl": "${images}", "targetPath": "input/images" }
    ],
    "parameterSet": {
      "appArgs": [
        { "name": "generator mode", "arg": "--generator-mode" },
        { "name": "generator mode value", "arg": "${generator_mode}" },
        { "name": "grid width", "arg": "--grid-width" },
        { "name": "grid width value", "arg": "${grid_width}" },
        { "name": "grid height", "arg": "--grid-height" },
        { "name": "grid height value", "arg": "${grid_height}" },
        { "name": "spray mode", "arg": "--spray-mode" },
        { "name": "spray mode value", "arg": "${spray_mode}" }
      ],
      "schedulerOptions": [
        { "name": "slurm account", "arg": "-A ${slurm_account}" },
        { "name": "job name", "arg": "--job-name=geospatial-gpkg" },
        { "name": "cpu cores", "arg": "--cpus-per-task=10" }
      ],
      "containerArgs": [
        { "name": "binding", "arg": "--bind $PWD/output:/output" }
      ],
      "envVariables": [
        { "key": "OMP_NUM_THREADS", "value": "10" },
        { "key": "MKL_NUM_THREADS", "value": "10" },
        { "key": "FOV_WIDTH_FT", "value": "${fov_width_ft}" },
        { "key": "FOV_HEIGHT_FT", "value": "${fov_height_ft}" },
        { "key": "GPS_OFFSET_X_FT", "value": "${gps_offset_x_ft}" },
        { "key": "GPS_OFFSET_Y_FT", "value": "${gps_offset_y_ft}" },
        { "key": "IMAGE_WIDTH_PX", "value": "${image_width_px}" },
        { "key": "IMAGE_HEIGHT_PX", "value": "${image_height_px}" },
        { "key": "SPRAY_LEVELS", "value": "${spray_levels}" },
        { "key": "SPRAY_THRESHOLDS", "value": "${spray_thresholds}" }
      ],
      "archiveFilter": { "includeLaunchFiles": false }
    }
  }
}
